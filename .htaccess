Options -Indexes
<FilesMatch "(^\.|\.(env|sql|log|bat|md|ini|lock)$)">
    Require all denied
</FilesMatch>
RewriteEngine On
RewriteRule ^(?:storage|services|migrations|tests|docs|\.git|\.footer-backups)(?:/|$) - [F,L,NC]
RewriteRule ^(?:assistant-(?:setup|test)|migrate|telegram-(?:chat-ids|test-notification|support-test|poll|worker))\.php$ - [F,L,NC]
