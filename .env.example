APP_URL=https://example.com
APP_ENV=production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=webstart
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Telegram BotFather token
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram administrator chat IDs
TELEGRAM_ADMIN_CHAT_IDS=
# Secret checked by telegram-webhook.php
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS webhook URL
TELEGRAM_WEBHOOK_URL=https://example.com/telegram-webhook.php

# Optional AI provider. Keep real keys only in the local .env.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_API_BASE_URL=https://api.openai.com/v1
AI_MAX_INPUT_LENGTH=2000
AI_MAX_HISTORY_MESSAGES=12
AI_MAX_OUTPUT_TOKENS=900
AI_MAX_REQUESTS_PER_DAY=100
