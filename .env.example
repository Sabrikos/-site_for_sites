APP_URL=http://127.0.0.1:8000
APP_ENV=local
ADMIN_SESSION_IDLE_SECONDS=1800

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=webstart
DB_USER=root
DB_PASSWORD=

TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=notifications
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_SUPPORT_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

AI_PROVIDER=decision-tree
# Visitor traffic remains off until processing terms and privacy design are agreed.
GIGACHAT_CHAT_ENABLED=0
GIGACHAT_AUTH_KEY=
# Set scope from your API account: GIGACHAT_API_PERS / B2B / CORP (full name).
GIGACHAT_SCOPE=
GIGACHAT_MODEL=GigaChat-2-Max
# Optional PEM CA bundle from the official certificate instructions. Never disable TLS.
GIGACHAT_CA_BUNDLE=

# Used only when AI_PROVIDER=openai-compatible. No automatic provider fallback.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_API_BASE_URL=https://api.openai.com/v1
# For DeepSeek use https://api.deepseek.com/v1 and a DeepSeek model name.
AI_MAX_INPUT_LENGTH=2000
AI_MAX_HISTORY_MESSAGES=12
AI_MAX_OUTPUT_TOKENS=900
AI_MAX_REQUESTS_PER_DAY=100
